# This file documents the environment variables consumed by the various
# workspaces. Copy to .env (root) and to server/.env, app/.env as needed.

# ─── server (Hono + SQLite) ──────────────────────────────
# See server/.env.example for the full list. In particular:
#   JWT_SECRET, ADMIN_EMAIL, ADMIN_PASSWORD, SEED_APPOINTMENTS,
#   PORT, DATABASE_PATH

# ─── app (Vite) ─────────────────────────────────────────
# In dev, leave VITE_API_BASE empty: the dev proxy takes care of /api.
# In prod (separate API host), set it to e.g. https://api.example.com
VITE_API_BASE=
