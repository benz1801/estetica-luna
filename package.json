{
  "name": "estetica-luna",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "app",
    "server"
  ],
  "scripts": {
    "dev": "npm-run-all --parallel dev:*",
    "dev:app": "npm --workspace app run dev",
    "dev:server": "npm --workspace server run dev",
    "build:app": "npm --workspace app run build",
    "db:generate": "npm --workspace server run db:generate",
    "db:migrate": "npm --workspace server run db:migrate"
  },
  "devDependencies": {
    "npm-run-all": "^4.1.5"
  }
}
